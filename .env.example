# ==================================================
# KOMBINU - ENVIRONMENT VARIABLES TEMPLATE
# ==================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ==================================================
# DJANGO SETTINGS
# ==================================================

# Secret key for Django (generate a new one for production!)
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
# Example for production: kombinu.onrender.com,www.kombinu.com
# Example for local: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================================================
# SECURITY SETTINGS (Production)
# ==================================================

# CSRF Trusted Origins (for production, comma-separated, with https://)
# Example: https://kombinu.onrender.com,https://www.kombinu.com
# CSRF_TRUSTED_ORIGINS=https://kombinu.onrender.com

# CORS Settings
# Default is False (closed). Never set True in production.
CORS_ALLOW_ALL_ORIGINS=False

# CORS Allowed Origins (comma-separated, with scheme, no trailing slash)
# Local: http://localhost:5173
# Production: https://kombinu.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HSTS max-age in seconds, only applied when DEBUG=False (default: 3600).
# Increase gradually (e.g. 86400, then 31536000) once HTTPS is confirmed.
# SECURE_HSTS_SECONDS=3600

# Number of proxies in front of the app, used by API throttling to read the
# client IP from X-Forwarded-For. Leave unset unless the proxy chain is known.
# DRF_NUM_PROXIES=1

# ==================================================
# DATABASE SETTINGS
# ==================================================

# Local development (SQLite — não requer instalação)
DATABASE_URL=sqlite:///db.sqlite3

# Produção (PostgreSQL — Neon, Render, etc.)
# DATABASE_URL=postgresql://user:password@localhost:5432/kombinu_db

# ==================================================
# OPTIONAL SETTINGS
# ==================================================

# Timezone (default: Africa/Luanda)
# TZ=Africa/Luanda

# Language Code (default: pt-br)
# LANGUAGE_CODE=pt-br
